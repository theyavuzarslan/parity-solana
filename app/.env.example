# Parity app environment. Copy to .env.local (gitignored) for local runs, or set these in the
# Vercel project settings. Names only: never commit real values.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time: anyone can read them.

# devnet | localnet (default devnet)
NEXT_PUBLIC_CLUSTER=

# RPC endpoint. It is shipped to every browser, so use a key-less or domain-restricted devnet RPC
# (e.g. a provider endpoint locked to your Vercel domain). Never put an unrestricted API key here.
# Unset: https://api.devnet.solana.com (public and rate-limited) or http://127.0.0.1:8899 on localnet.
NEXT_PUBLIC_RPC_URL=

# Parity program id. Unset: the app runs on preview (mock) data.
NEXT_PUBLIC_PROGRAM_ID=

# Test collateral mints, from keys/mints.<cluster>.json (the faucet route needs both).
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_USDG_MINT=

# Optional, labels only: what scripts/src/relay.ts forwards on devnet. ecb (default) | hermes
# (set hermes when the relay runs with PYTH_API_KEY).
NEXT_PUBLIC_RELAY_SOURCE=

# --- server only (never NEXT_PUBLIC_) ---

# Faucet mint authority: the JSON array in keys/faucet.json (e.g. [12,34,...]). Server-only; it
# signs mint_to and pays ATA rent. Keep the faucet key topped up with devnet SOL.
FAUCET_SECRET_KEY=

# Optional: Pyth Hermes API key for /api/prices (server-only; sent as a Bearer header, never to the
# client). Unset: ECB reference rates via Frankfurter.
PYTH_API_KEY=

# Local development only: PARITY_DEV_WALLET=1 enables the /api/dev/* test wallets that sign with
# keys/*.json on this machine. Never set PARITY_DEV_WALLET on Vercel.
# PARITY_DEV_WALLET=
